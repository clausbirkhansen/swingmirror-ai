{
  "name": "swingmirror",
  "version": "0.9.0",
  "private": true,
  "description": "SwingMirror \u2013 Golf Swing Replay & Training",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "native:add": "cap add android && cap add ios && node scripts/patch-native.mjs",
    "native:patch": "node scripts/patch-native.mjs",
    "sync": "cap sync && node scripts/patch-native.mjs",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
